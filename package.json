{
  "name": "in2eat",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @in2eat/web build",
    "dev": "pnpm -r --filter=./packages/* build && pnpm --filter @in2eat/web dev",
    "validate:content": "pnpm --filter @in2eat/content-schema build && node packages/content-schema/dist/cli.js content",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
